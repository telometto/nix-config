+// Kaizer's root-owned runtime layer is shared by root, the greeter and GUIs.
+// Read it on lookup so an existing process observes an atomic key rotation.
+fn managed_server_options() -> HashMap<String, String> {
+    // Direct desktop access does not depend on ID/relay registration.
+    let mut options = HashMap::from([
+        ("direct-server".to_owned(), "Y".to_owned()),
+        ("direct-access-port".to_owned(), "21120".to_owned()),
+    ]);
+    let Ok(contents) = fs::read_to_string("/run/rustdesk/server-options") else {
+        return options;
+    };
+    let lines: Vec<_> = contents.lines().collect();
+    let [server, key] = lines.as_slice() else {
+        return options;
+    };
+    if server.is_empty() || key.is_empty() {
+        return options;
+    }
+    options.extend([
+        ("custom-rendezvous-server".to_owned(), (*server).to_owned()),
+        ("relay-server".to_owned(), (*server).to_owned()),
+        ("key".to_owned(), (*key).to_owned()),
+    ]);
+    options
+}
